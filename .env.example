# AYROVI server
PORT=3000
NODE_ENV=development

# SQLite database location
DATABASE_PATH=./data/qatafo_cart.sqlite

# Bootstrap Admin account (separate from customer login)
# Required in production. Use a unique password of at least 12 characters.
ADMIN_EMAIL=admin@ayrovi.tn
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Customer authentication
# Required in production. Generate at least 32 random bytes, for example:
# openssl rand -hex 32
CUSTOMER_AUTH_SECRET=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://your-ayrovi-domain.example

# Immediate card deposit payments — Konnect Tunisia (server-side only)
# Create a Konnect organisation, then copy its API key and receiver wallet ID.
KONNECT_ENVIRONMENT=sandbox
KONNECT_API_KEY=
KONNECT_WALLET_ID=

# Google OAuth customer login (server-side only)
# Register GOOGLE_CALLBACK_URL exactly in Google Cloud as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-ayrovi-domain.example/api/customer/auth/google/callback

# Facebook OAuth customer login (server-side code flow; Graph API v26.0).
# Keep FACEBOOK_APP_SECRET on the server and register the callback exactly in Meta Developers.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://your-ayrovi-domain.example/api/customer/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v26.0

# AYROVI AI Core — active Phase 1 Responses adapter, STRICTEMENT côté serveur.
# Jamais de clé dans le code client ni de variable VITE_* (tout VITE_* part au navigateur).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ASSISTANT_HAIKU_MODEL=claude-haiku-4-5-20251001
ASSISTANT_SONNET_MODEL=claude-sonnet-4-5-20250929
# Legacy Voice input/output remains unchanged in Phase 1.
# STT: Groq Whisper transcribes the microphone recording.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# TTS: Gemini returns raw PCM; the server wraps it as WAV before browser playback.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_TIMEOUT_MS=20000
# Optional fallback for both Whisper STT and TTS when the corresponding Gemini/Groq key is absent.
# AI Core also registers OpenAI Responses as a target, but Phase 1 never routes traffic to it.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_DEFAULT_MODEL=gpt-5.6-terra
OPENAI_DEEP_MODEL=gpt-5.6-sol

# Live-provider readiness harness — fail closed by default. Do not enable or
# attest billing without an approved, time-bounded Live Provider Probe change.
AYROVI_LIVE_PROVIDER_PROBE_ENABLED=false
AYROVI_LIVE_PROVIDER_PROBE_APPROVAL_ID=
AYROVI_TARGET_PROVIDER_BILLING_READY=not-attested
AYROVI_AI_BUDGET_ENFORCEMENT=false
AYROVI_PROBE_MAX_RUN_USD=
AYROVI_PROBE_ESTIMATED_RUN_USD=
AYROVI_PROBE_DAILY_BUDGET_USD=

# AI Core Vision: identification + prix visible dans une seule requête structurée.
AYROVIX_PROVIDER_TIMEOUT_MS=12000
# SerpApi Google Lens: correspondances visuelles, images et pages produit.
# Clé serveur uniquement; l'image temporaire SerpApi expire automatiquement.
SERPAPI_KEY=
AYROVIX_VISUAL_SEARCH_TIMEOUT_MS=10000
AYROVIX_LENS_COUNTRY=fr
# AI Core Web Search: fallback texte pour liens/QR/barcodes ou si Google Lens ne trouve rien.
AYROVIX_SEARCH_TIMEOUT_MS=7000
# Provider-neutral capability gate; provider selection remains in AI Core.
AYROVIX_AI_WEB_SEARCH=true

# وكيل «مجلتي» داخل الأدمين — AI Core Web Search + صور مرجعية + Stock مرخص.
# إذا تُرك MAGAZINE_AGENT_MODEL فارغًا يُستخدم ASSISTANT_SONNET_MODEL/ANTHROPIC_MODEL.
MAGAZINE_AGENT_MODEL=claude-sonnet-4-5-20250929
# SERPAPI_KEY أعلاه يُستخدم أيضًا للبحث عن صور مرجعية (لا تُنشر مباشرة).
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Vérification de prix avec rendu JavaScript (repli après le fetch direct).
# Choisissez "auto", "scraperapi", "scrapingbee" ou "brightdata". Toutes les clés restent côté serveur.
AYROVIX_RENDER_PROVIDER=auto
AYROVIX_RENDER_TIMEOUT_MS=18000
AYROVIX_SCRAPER_COUNTRY=fr
# ScraperAPI : le module envoie render=true.
SCRAPERAPI_KEY=
AYROVIX_SCRAPER_PREMIUM=false
# ScrapingBee : render_js=true avec proxy premium (stealth optionnel).
SCRAPINGBEE_API_KEY=
AYROVIX_SCRAPINGBEE_STEALTH=false
# Bright Data Web Unlocker : token + nom de zone requis ensemble.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=
# Signature HMAC des devis Lens (prix, devise, titre, lien de référence et statut), 32+ caractères.
# En l'absence de cette valeur, CUSTOMER_AUTH_SECRET est utilisé.
AYROVIX_QUOTE_SECRET=
# OCR local conservé uniquement pour l'ancien endpoint /api/extract-image, hors Lens.
AYROVIX_OCR_TIMEOUT_MS=7000

# Customer SMS OTP — provider-independent HTTPS webhook for a Tunisian provider.
# The adapter must accept AYROVI's signed server request and deliver to +216 numbers.
CUSTOMER_OTP_PROVIDER=webhook
CUSTOMER_OTP_WEBHOOK_URL=
CUSTOMER_OTP_WEBHOOK_TOKEN=

# Optional legacy adapter only; not the recommended Tunisia deployment path.
# Set CUSTOMER_OTP_PROVIDER=twilio_verify only if your own Twilio account supports the route.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Automated SQLite backup. S3-compatible values support AWS S3, Cloudflare R2 or Backblaze B2.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./data/backups
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=ayrovi/sqlite
# Set true only after the external destination is tested; a failed upload then fails the backup job.
BACKUP_REQUIRE_EXTERNAL=false

# Optional comma-separated allowlist for cross-origin API clients.
# Same-origin browser requests work without this value.
CORS_ORIGINS=https://www.ayrovi.tn,https://ayrovi.tn

# Optional browser-extension default
EXTENSION_DEFAULT_API_URL=http://localhost:3000

# Admin bootstrap recovery (one-time): force ADMIN_EMAIL/ADMIN_PASSWORD onto the existing admin
# ADMIN_BOOTSTRAP_RESET=yes

# ===== إرسال الفواتير بالبريد (اختياري — بدونها تُسجَّل الرسائل في logs فقط) =====
# المزوّد: resend | brevo | sendgrid
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=AYROVI <no-reply@yourdomain.tn>

# --- Warehouse Core integration (Arrival CRM -> Warehouse Expected Arrivals) ---
# Server-side only. The "Send to Warehouse" action POSTs the confirmed Customer
# Arrival Card to the Warehouse integration API. Never exposed to the frontend.
WAREHOUSE_API_URL=
# Static integration secret; must match WAREHOUSE_INTEGRATION_API_KEY on the
# Warehouse side (or use a registered API client id/secret instead).
WAREHOUSE_API_KEY=
