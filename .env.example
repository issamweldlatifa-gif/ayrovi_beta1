# AYROVI server
PORT=3000
NODE_ENV=development

# SQLite database location
DATABASE_PATH=./data/qatafo_cart.sqlite

# Bootstrap Admin account (separate from customer login)
# Required in production. Use a unique password of at least 12 characters.
ADMIN_EMAIL=admin@ayrovi.tn
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Customer authentication
# Required in production. Generate at least 32 random bytes, for example:
# openssl rand -hex 32
CUSTOMER_AUTH_SECRET=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://your-ayrovi-domain.example

# Google OAuth customer login (server-side only)
# Register GOOGLE_CALLBACK_URL exactly in Google Cloud as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-ayrovi-domain.example/api/customer/auth/google/callback

# Provider-independent customer SMS OTP adapter
# Production supports an HTTPS webhook so Twilio or another provider can be connected later.
CUSTOMER_OTP_PROVIDER=webhook
CUSTOMER_OTP_WEBHOOK_URL=https://your-private-sms-adapter.example/send
CUSTOMER_OTP_WEBHOOK_TOKEN=replace-with-a-private-bearer-token

# Optional comma-separated allowlist for cross-origin API clients.
# Same-origin browser requests work without this value.
CORS_ORIGINS=https://www.ayrovi.tn,https://ayrovi.tn

# Optional browser-extension default
EXTENSION_DEFAULT_API_URL=http://localhost:3000
