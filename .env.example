# AYROVI server
PORT=3000
NODE_ENV=development

# SQLite database location
DATABASE_PATH=./data/qatafo_cart.sqlite

# Bootstrap Admin account (separate from customer login)
# Required in production. Use a unique password of at least 12 characters.
ADMIN_EMAIL=admin@ayrovi.tn
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Customer authentication
# Required in production. Generate at least 32 random bytes, for example:
# openssl rand -hex 32
CUSTOMER_AUTH_SECRET=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://your-ayrovi-domain.example

# Google OAuth customer login (server-side only)
# Register GOOGLE_CALLBACK_URL exactly in Google Cloud as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-ayrovi-domain.example/api/customer/auth/google/callback

# AYROVIX Lens — compréhension d'image (Multi-provider, STRICTEMENT côté serveur)
# Jamais de clé dans le code client ni de variable VITE_* (tout VITE_* part au navigateur).
# Ordre automatique : GEMINI (gratuit) -> OPENAI (cheap) -> ANTHROPIC (Claude) -> fallback local
# === MEILLEURE ALTERNATIVE GRATUITE quand Claude est à court de crédit ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Alternative bon marché (~$0.15/1M tokens vision)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Modèle Vision rapide validé pour AYROVIX Lens (clé serveur uniquement).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Démo uniquement: ce fallback ne reconnaît pas réellement le produit. Gardez-le désactivé en production.
AYROVIX_ALLOW_LOCAL_FALLBACK=false
# Budgets maximums pour éviter les cascades de tentatives lentes
AYROVIX_AI_TIMEOUT_MS=14000
AYROVIX_PROVIDER_TIMEOUT_MS=5000
AYROVIX_OCR_TIMEOUT_MS=7000
AYROVIX_SEARCH_TIMEOUT_MS=4000
# Recherche produit externe — OPTIONNEL mais améliore Lens
# SERPAPI_KEY = Google Shopping (payant, 100/mois gratuit)
SERPAPI_KEY=
# BRAVE_API_KEY = Brave Search (FREE 2000/mois sans carte) — https://brave.com/search/api/  — meilleur pour free tier
BRAVE_API_KEY=
# DuckDuckGo Free — 100% gratuit sans clé, utilisé automatiquement si SERPAPI/BRAVE non configurés

# Provider-independent customer SMS OTP adapter
# Production supports an HTTPS webhook so Twilio or another provider can be connected later.
CUSTOMER_OTP_PROVIDER=webhook
CUSTOMER_OTP_WEBHOOK_URL=https://your-private-sms-adapter.example/send
CUSTOMER_OTP_WEBHOOK_TOKEN=replace-with-a-private-bearer-token

# Optional comma-separated allowlist for cross-origin API clients.
# Same-origin browser requests work without this value.
CORS_ORIGINS=https://www.ayrovi.tn,https://ayrovi.tn

# Optional browser-extension default
EXTENSION_DEFAULT_API_URL=http://localhost:3000

# Admin bootstrap recovery (one-time): force ADMIN_EMAIL/ADMIN_PASSWORD onto the existing admin
# ADMIN_BOOTSTRAP_RESET=yes

# ===== إرسال الفواتير بالبريد (اختياري — بدونها تُسجَّل الرسائل في logs فقط) =====
# المزوّد: resend | brevo | sendgrid
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=AYROVI <no-reply@yourdomain.tn>
