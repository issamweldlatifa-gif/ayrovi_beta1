# AYROVI server
PORT=3000
NODE_ENV=development

# SQLite database location
DATABASE_PATH=./data/qatafo_cart.sqlite

# Bootstrap Admin account (separate from customer login)
# Required in production. Use a unique password of at least 12 characters.
ADMIN_EMAIL=admin@ayrovi.tn
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Customer authentication
# Required in production. Generate at least 32 random bytes, for example:
# openssl rand -hex 32
CUSTOMER_AUTH_SECRET=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://your-ayrovi-domain.example

# Google OAuth customer login (server-side only)
# Register GOOGLE_CALLBACK_URL exactly in Google Cloud as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-ayrovi-domain.example/api/customer/auth/google/callback

# AYROVIX Lens — Claude + SerpApi Google Lens, STRICTEMENT côté serveur.
# Jamais de clé dans le code client ni de variable VITE_* (tout VITE_* part au navigateur).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Voice transcription only (server-side). The chat/vision model remains Claude.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Claude Vision: identification + prix visible dans une seule requête structurée.
AYROVIX_PROVIDER_TIMEOUT_MS=12000
# SerpApi Google Lens: correspondances visuelles, images et pages produit.
# Clé serveur uniquement; l'image temporaire SerpApi expire automatiquement.
SERPAPI_KEY=
AYROVIX_VISUAL_SEARCH_TIMEOUT_MS=10000
AYROVIX_LENS_COUNTRY=fr
# Claude Web Search: fallback texte pour liens/QR/barcodes ou si Google Lens ne trouve rien.
AYROVIX_SEARCH_TIMEOUT_MS=7000
AYROVIX_ANTHROPIC_WEB_SEARCH=true
# Vérification de prix avec rendu JavaScript (repli après le fetch direct).
# Choisissez "auto", "scraperapi", "scrapingbee" ou "brightdata". Toutes les clés restent côté serveur.
AYROVIX_RENDER_PROVIDER=auto
AYROVIX_RENDER_TIMEOUT_MS=18000
AYROVIX_SCRAPER_COUNTRY=fr
# ScraperAPI : le module envoie render=true.
SCRAPERAPI_KEY=
AYROVIX_SCRAPER_PREMIUM=false
# ScrapingBee : render_js=true avec proxy premium (stealth optionnel).
SCRAPINGBEE_API_KEY=
AYROVIX_SCRAPINGBEE_STEALTH=false
# Bright Data Web Unlocker : token + nom de zone requis ensemble.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=
# Signature HMAC des devis Lens (prix, devise, titre, lien de référence et statut), 32+ caractères.
# En l'absence de cette valeur, CUSTOMER_AUTH_SECRET est utilisé.
AYROVIX_QUOTE_SECRET=
# OCR local conservé uniquement pour l'ancien endpoint /api/extract-image, hors Lens.
AYROVIX_OCR_TIMEOUT_MS=7000

# Provider-independent customer SMS OTP adapter
# Production supports an HTTPS webhook so Twilio or another provider can be connected later.
CUSTOMER_OTP_PROVIDER=webhook
CUSTOMER_OTP_WEBHOOK_URL=https://your-private-sms-adapter.example/send
CUSTOMER_OTP_WEBHOOK_TOKEN=replace-with-a-private-bearer-token

# Optional comma-separated allowlist for cross-origin API clients.
# Same-origin browser requests work without this value.
CORS_ORIGINS=https://www.ayrovi.tn,https://ayrovi.tn

# Optional browser-extension default
EXTENSION_DEFAULT_API_URL=http://localhost:3000

# Admin bootstrap recovery (one-time): force ADMIN_EMAIL/ADMIN_PASSWORD onto the existing admin
# ADMIN_BOOTSTRAP_RESET=yes

# ===== إرسال الفواتير بالبريد (اختياري — بدونها تُسجَّل الرسائل في logs فقط) =====
# المزوّد: resend | brevo | sendgrid
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=AYROVI <no-reply@yourdomain.tn>
