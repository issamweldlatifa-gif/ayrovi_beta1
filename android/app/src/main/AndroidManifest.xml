<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".AyroviApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- AYWEBs §24 : partage Android (texte brut) — la détection est serveur. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- AYWEBs §25 : liens profonds ayrovi://aywebs[…]. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ayrovi" android:host="aywebs" />
            </intent-filter>
        </activity>

        <!-- AYWEBs V2 : navigateur marchand natif (barre flottante Add to Cart).
             Non exporté : seule l'app l'ouvre via le pont AyWebsBrowse. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".AyWebsBrowseActivity"
            android:process=":merchant"
            android:label="@string/aywebs_browser_title"
            android:theme="@style/AppTheme.NoActionBar"
            android:parentActivityName=".MainActivity"
            android:exported="false" />

        <service android:name=".MerchantDataService" android:process=":merchant" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Caméra : Lens (identification produit) et OCEREX (prix depuis une image).
         La caméra reste optionnelle : le site est pleinement utilisable sans
         (import de photo, lien, texte). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Micro (SONIM vocal, notes vocales) — ajouté le 2026-10-03.
         BridgeWebChromeClient demande DÉJÀ la permission à l'exécution pour
         getUserMedia({audio:true}), mais Android refuse silencieusement toute
         permission non déclarée : la demande n'aboutissait à aucune boîte de
         dialogue et l'enregistrement échouait sans le moindre message.
         La déclaration est donc la condition nécessaire qui manquait. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Volontairement NON ajouté : POST_NOTIFICATIONS.
         Le manifeste n'est pas le verrou des notifications : il n'existe ni
         plugin push, ni table de jetons d'appareil, ni service FCM côté serveur.
         Déclarer la permission seule ferait croire que les notifications
         fonctionnent alors que rien ne les envoie — l'ajout doit se faire avec
         la pile push complète, pas avant. -->

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
