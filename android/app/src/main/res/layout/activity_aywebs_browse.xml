<?xml version="1.0" encoding="utf-8"?>
<!-- AYWEBs V2 — navigateur marchand (capture 1) : barre haute (X, URL, refresh),
     WebView marchand, barre flottante basse : retour, avant, Panier, Favoris,
     bouton orange « Add to Cart ». Aucun montant, aucune logique en XML. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/aywebs_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/aywebs_close"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />

        <TextView
            android:id="@+id/aywebs_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="#101828"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/aywebs_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/aywebs_refresh"
            android:src="@android:drawable/ic_menu_rotate" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/aywebs_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <WebView
        android:id="@+id/aywebs_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <ImageButton
            android:id="@+id/aywebs_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/aywebs_back"
            android:src="@android:drawable/ic_media_previous" />

        <ImageButton
            android:id="@+id/aywebs_forward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/aywebs_forward"
            android:src="@android:drawable/ic_media_next" />

        <Button
            android:id="@+id/aywebs_cart"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:text="@string/aywebs_cart"
            android:textColor="#1D3F8F"
            android:textSize="12sp" />

        <Button
            android:id="@+id/aywebs_wish"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:text="@string/aywebs_wish"
            android:textColor="#1D3F8F"
            android:textSize="12sp" />

        <Button
            android:id="@+id/aywebs_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="#F18902"
            android:text="@string/aywebs_add_to_cart"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
