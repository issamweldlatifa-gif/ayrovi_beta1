<?xml version="1.0" encoding="utf-8"?>
<!-- AYWEBs V2 — confirmation ancrée en bas, sans quitter le marchand. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_aywebs_sheet"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp"
    android:gravity="center_horizontal">

    <ImageButton
        android:id="@+id/aywebs_added_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="end"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/aywebs_close"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/aywebs_added"
        android:src="@android:drawable/ic_menu_add" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/aywebs_added"
        android:textColor="#101828"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/aywebs_added_image"
        android:layout_width="96dp"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        android:background="#F2F4F7"
        android:contentDescription="@string/aywebs_added"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/aywebs_added_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="#475467"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/aywebs_added_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#101828"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/aywebs_added_totals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#475467"
        android:textSize="14sp" />

    <Button
        android:id="@+id/aywebs_added_checkout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="22dp"
        android:background="#F18902"
        android:text="@string/aywebs_proceed_checkout"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/aywebs_added_continue"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:text="@string/aywebs_continue_shopping"
        android:textColor="#344054"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
