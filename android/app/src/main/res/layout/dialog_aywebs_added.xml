<?xml version="1.0" encoding="utf-8"?>
<!-- AYWEBs V2 — confirmation d'ajout sans quitter le marchand (capture 4). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/aywebs_added"
        android:src="@android:drawable/ic_menu_add" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/aywebs_added"
        android:textColor="#101828"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/aywebs_added_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#475467"
        android:textSize="14sp" />

    <Button
        android:id="@+id/aywebs_added_checkout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="#F18902"
        android:text="@string/aywebs_proceed_checkout"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/aywebs_added_continue"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="@string/aywebs_continue_shopping"
        android:textColor="#344054"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
