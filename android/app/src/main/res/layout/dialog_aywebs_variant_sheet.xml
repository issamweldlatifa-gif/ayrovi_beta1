<?xml version="1.0" encoding="utf-8"?>
<!-- AYWEBs V2 — feuille de variantes PAR-DESSUS le marchand (capture 3). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/aywebs_sheet_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/aywebs_close"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/aywebs_select_item"
            android:textColor="#101828"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aywebs_sheet_product"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#101828"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/aywebs_sheet_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/aywebs_new"
            android:textColor="#101828" />

        <LinearLayout
            android:id="@+id/aywebs_sheet_groups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Spinner
            android:id="@+id/aywebs_sheet_qty"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/aywebs_sheet_add"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="#F18902"
            android:text="@string/aywebs_add_to_cart"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
