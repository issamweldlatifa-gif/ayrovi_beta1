<?xml version="1.0" encoding="utf-8"?>
<!-- AYWEBs V2 — feuille native ancrée en bas, inspirée du flux proxy-shopping Buyee.
     Les champs de prix, d'état et de stock ne s'affichent que si le serveur les fournit. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_aywebs_sheet"
    android:clipToPadding="false"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/aywebs_sheet_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/aywebs_close"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/aywebs_select_item"
            android:textColor="#101828"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/aywebs_sheet_image"
                android:layout_width="92dp"
                android:layout_height="112dp"
                android:background="#F2F4F7"
                android:contentDescription="@string/aywebs_select_item"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/aywebs_sheet_product"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:textColor="#101828"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/aywebs_sheet_condition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#475467"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/aywebs_sheet_availability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#475467"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/aywebs_sheet_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#101828"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/aywebs_sheet_groups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <Spinner
            android:id="@+id/aywebs_sheet_qty"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/aywebs_sheet_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFF3F2"
            android:padding="10dp"
            android:textColor="#B42318"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/aywebs_sheet_add"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="#F18902"
            android:text="@string/aywebs_add_to_cart"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
