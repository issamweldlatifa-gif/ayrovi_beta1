<?xml version="1.0" encoding="utf-8"?>
<!-- AYWEBs — connexion DANS le tiroir, sans quitter la boutique (04/10/2026).
     Remarque client : « داخل favorite كيف نحبو نسجل دخول يخرج تطبيق ». Le bouton
     « se connecter » renvoyait vers l'écran compte, donc hors du magasin, en
     plein achat. Ces deux champs parlent directement à
     POST /api/customer/auth/email/login : on revient au tiroir, connecté,
     sans avoir bougé d'un pixel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/aywebs_sheet_login"
            android:textColor="#101828"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/aywebs_login_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/aywebs_close"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/aywebs_login_stay"
        android:textColor="#667085"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/aywebs_login_email"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:autofillHints="emailAddress"
        android:background="#F2F4F7"
        android:hint="@string/aywebs_login_email"
        android:inputType="textEmailAddress"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#101828"
        android:textColorHint="#98A2B3"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/aywebs_login_password"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:autofillHints="password"
        android:background="#F2F4F7"
        android:hint="@string/aywebs_login_password"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#101828"
        android:textColorHint="#98A2B3"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/aywebs_login_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#B42318"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/aywebs_login_submit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="#F18902"
        android:text="@string/aywebs_sheet_login"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
</LinearLayout>
