<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_aywebs_sheet"
    android:clipToPadding="false"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/aywebs_support_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/aywebs_close"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />

        <TextView
            android:id="@+id/aywebs_support_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/aywebs_purchase_support_title"
            android:textColor="#101828"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aywebs_support_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/aywebs_purchase_support_message"
            android:textColor="#475467"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/aywebs_support_product_name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:hint="@string/aywebs_support_product_name"
            android:inputType="textCapSentences"
            android:maxLength="300" />

        <EditText
            android:id="@+id/aywebs_support_requirements"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:hint="@string/aywebs_support_requirements"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="1000"
            android:padding="10dp" />

        <Spinner
            android:id="@+id/aywebs_support_quantity"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/aywebs_support_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFF3F2"
            android:padding="10dp"
            android:textColor="#B42318"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/aywebs_support_send"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="#F18902"
            android:text="@string/aywebs_support_send"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
