{
  "expo": {
    "name": "AYROVI",
    "slug": "ayrovi",
    "scheme": "ayrovi",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#FF7900",
    "android": {
      "package": "app.ayrovi.mobile",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FAFAFA"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "ayrovi.tn"
            },
            {
              "scheme": "https",
              "host": "www.ayrovi.tn"
            },
            {
              "scheme": "https",
              "host": "ayrovi-beta1-1.onrender.com"
            },
            {
              "scheme": "https",
              "host": "ayrovi-beta1-moo8.onrender.com",
              "pathPrefix": "/"
            }
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "app.ayrovi.mobile",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            /*
             * Un APK qui embarque les bibliothèques natives des QUATRE
             * architectures paye trois fois le même code. Le découpage par ABI
             * produit un APK par processeur : c'est le seul réglage qui change
             * vraiment l'ordre de grandeur (≈ -60 %), et non quelques pour
             * cent.
             */
            "enableSeparateBuildPerCPUArchitecture": true,
            /* R8 : retrait du code Java/Kotlin inutilisé. */
            "enableProguardInReleaseBuilds": true,
            /* Ressources Android non référencées — icônes et chaînes mortes. */
            "enableShrinkResourcesInReleaseBuilds": true,
            /* Hermes : le moteur JS déjà adopté par le projet. */
            "jsEngine": "hermes",
            /*
             * On garde les DEUX ABI encore rencontrées en Tunisie : arm64 pour
             * les appareils récents, armeabi-v7a pour les anciens 32 bits.
             */
            "abiFilters": ["arm64-v8a", "armeabi-v7a"]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AYROVI utilise la caméra pour scanner un code-barres ou un QR code et chercher le produit.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
