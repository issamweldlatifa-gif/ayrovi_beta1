{
  "name": "ayrovi",
  "version": "3.6.0",
  "description": "AYROVI — Universal Cross-Border Shopping & Visual AI Platform (React + Vite + TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "build:client": "vite build",
    "build:server": "node -e 'require(\"esbuild\").buildSync({entryPoints:[\"src/server.ts\"],bundle:true,platform:\"node\",target:\"node20\",outfile:\"dist/server.js\",external:[\"better-sqlite3\",\"jsdom\",\"express\",\"compression\",\"cors\",\"dotenv\",\"tesseract.js\",\"multer\",\"sharp\"]})'",
    "build": "npm run build:client && npm run build:server",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "backup": "node scripts/backup-sqlite.mjs"
  },
  "keywords": [
    "ayrovi",
    "e-commerce",
    "react",
    "vite",
    "proxy-shopping",
    "vision-ocr",
    "screenshot-scraper",
    "tunisia"
  ],
  "author": "AYROVI Team",
  "license": "ISC",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@zxing/library": "0.21.3",
    "autoprefixer": "^10.5.4",
    "better-sqlite3": "^11.10.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.2",
    "express": "^4.22.2",
    "jsdom": "^24.1.3",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "multer": "^2.2.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
