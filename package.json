{
  "name": "ayrovi",
  "version": "3.10.4",
  "description": "AYSONIC \u2014 Universal Cross-Border Shopping & Visual AI Platform (React + Vite + TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "build:client": "vite build",
    "build:server": "node -e 'require(\"esbuild\").buildSync({entryPoints:[\"src/server.ts\"],bundle:true,platform:\"node\",target:\"node20\",outfile:\"dist/server.js\",external:[\"better-sqlite3\",\"jsdom\",\"express\",\"compression\",\"cors\",\"dotenv\",\"tesseract.js\",\"multer\",\"sharp\",\"pdf-to-img\",\"mailparser\"]})'",
    "build": "npm run build:client && npm run build:server",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "audit:design": "node verify/zalando-audit.mjs",
    "backup": "node scripts/backup-sqlite.mjs",
    "android:assets": "node scripts/cap-assets.mjs && capacitor-assets generate --android",
    "android:sync": "npm run build:client && cap sync android",
    "android:open": "cap open android",
    "design:inventory": "node scripts/inventory-customer-design.mjs",
    "design:build": "node scripts/build-editorial-design.mjs",
    "design:check": "node scripts/build-editorial-design.mjs --check && node scripts/inventory-customer-design.mjs --check && npm run icons:check && npm run identity:check",
    "design:browser": "node verify/editorial-system.mjs",
    "verify:editorial-customer": "esbuild verify/editorial-customer-runner.ts --bundle --platform=node --format=cjs --packages=external --outfile=.cache/editorial-customer-runner.cjs && node .cache/editorial-customer-runner.cjs",
    "icons:check": "node scripts/check-icon-contract.mjs",
    "verify:editorial-states": "esbuild verify/editorial-states-runner.ts --bundle --platform=node --format=cjs --packages=external --outfile=.cache/editorial-states-runner.cjs && node .cache/editorial-states-runner.cjs",
    "verify:editorial-account": "esbuild verify/customer-account-functional.ts --bundle --platform=node --format=cjs --packages=external --outfile=.cache/editorial-account-runner.cjs && AYROVI_ACCOUNT_OUTPUT=screenshots/editorial/icon-correction/account node .cache/editorial-account-runner.cjs",
    "verify:sonim-actions": "node verify/sonim-actions-runner.mjs",
    "verify:sonim-history": "node verify/sonim-actions-runner.mjs verify/sonim-history.mjs",
    "verify:sonim-media": "node verify/sonim-actions-runner.mjs verify/sonim-media.mjs",
    "verify:sonim-playback": "node verify/sonim-actions-runner.mjs verify/sonim-playback.mjs",
    "verify:sonim-handsfree": "node verify/sonim-actions-runner.mjs verify/sonim-handsfree.mjs",
    "verify:variant-availability": "node verify/sonim-actions-runner.mjs verify/variant-availability.mjs verify/variant-availability-fixture.tsx",
    "verify:product-selection": "node verify/sonim-actions-runner.mjs verify/product-selection.mjs verify/product-selection-fixture.tsx",
    "identity:check": "node scripts/build-editorial-design.mjs --check && node scripts/check-brand-identity.mjs",
    "identity:test": "vitest run tests/brand-identity.test.ts",
    "prebuild:client": "npm run identity:check",
    "verify:identity": "esbuild verify/identity-runtime.ts --bundle --platform=node --format=cjs --packages=external --outfile=.cache/identity-runtime.cjs && node .cache/identity-runtime.cjs",
    "verify:lens-camera": "node verify/sonim-actions-runner.mjs verify/lens-camera-entry.mjs verify/lens-camera-fixture.tsx"
  },
  "keywords": [
    "ayrovi",
    "e-commerce",
    "react",
    "vite",
    "proxy-shopping",
    "vision-ocr",
    "screenshot-scraper",
    "tunisia"
  ],
  "author": "AYROVI Team",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/status-bar": "^7.0.6",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@zxing/library": "0.21.3",
    "autoprefixer": "^10.5.4",
    "better-sqlite3": "^11.10.0",
    "bidi-js": "^1.1.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.2",
    "express": "^4.22.2",
    "jsdom": "^24.1.3",
    "mailparser": "^3.9.17",
    "motion": "^13.1.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdf-to-img": "^5.0.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@types/better-sqlite3": "^7.6.10",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.6",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^6.0.3",
    "playwright": "^1.62.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": "^6.16.0",
    "mailparser": {
      "nodemailer": "^9.1.1"
    },
    "@capacitor/assets": {
      "@capacitor/cli": "$@capacitor/cli",
      "sharp": "$sharp"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
